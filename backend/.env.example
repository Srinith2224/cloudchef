# ---------- Required ----------
# MongoDB connection string (MongoDB Atlas free tier works)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cloudchef
# Any long random string. Used to sign login tokens.
SECRET=change-me-to-a-long-random-string

# ---------- Optional ----------
PORT=4000
# Frontend address(es) allowed to call the API, comma separated
CLIENT_URL=http://localhost:3000

# Google Gemini (AI recipes). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Cloudinary (image & video hosting). Without it, files are saved to backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail for verification codes (use a Google "App password", not your normal password).
# Without it, codes are printed in the backend console instead of emailed.
EMAIL_USER=
EMAIL_PASSWORD=

# Google sign-in (OAuth client ID). Without it, the Google button is hidden.
GOOGLE_CLIENT_ID=
